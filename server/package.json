{
  "name": "mm-auto",
  "author": "Mohamed Metwalli",
  "version": "0.0.0",
  "license": "MIT",
  "description": "An Agentic Approach For Factory Automation In The Automobile Industry",
  "main": "src/app.ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc --noEmit && esbuild src/app.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/app.js",
    "start": "node --enable-source-maps dist/app.js",
    "clean": "rm -rf dist",
    "dev": "node --watch --import tsx src/app.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/classic": "^1.0.48",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.16",
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.1",
    "@langchain/neo4j": "^0.1.20",
    "@langchain/tavily": "^1.2.0",
    "agenda": "^6.2.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "langchain": "^1.5.11",
    "mailtrap": "^4.10.0",
    "mongodb": "^6.21.0",
    "pg": "^8.23.0",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@12.0.2"
}
